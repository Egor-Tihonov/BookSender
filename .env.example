# .env.example — пример переменных окружения для локального запуска.
# Скопировать в .env и заполнить. Сам .env в git не попадает.
# На Koyeb те же переменные задаются в настройках сервиса.

TELEGRAM_TOKEN=
MODE=polling
WEBHOOK_URL=
PORT=8000

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_TO=

BATCH_WAIT=5m
MAX_FILE_MB=20
MAX_MAIL_MB=18
